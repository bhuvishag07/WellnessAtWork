            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bhuvisha.gohil@company.com\",\n  \"password\": \"Wellness#2026!\"\n}"
            },
            "url": "http://localhost:7500/api/auth/login"
          }
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
