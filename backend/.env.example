PORT=7500
MONGODB_URI=mongodb://127.0.0.1:27017/wellnessatwork
# Replace with a unique random secret of at least 32 characters.
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Firebase Admin SDK Configuration (Optional; Firebase authentication is disabled without it.)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web Client Configuration (Optional for frontend direct Auth)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
